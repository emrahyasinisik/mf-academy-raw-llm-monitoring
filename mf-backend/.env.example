# Copy to .env for local development. Do NOT commit real secrets.
APP_ENV=development
PORT=8080

# Local Postgres (Homebrew). On Render this is provided automatically.
DATABASE_URL=postgres://emrah@localhost:5432/mf_monitoring?sslmode=disable

# This value is fine for local development and ONLY for local development: it
# is public, so with APP_ENV=production the server refuses to start on it.
# Generate a real one with `openssl rand -base64 48` (32 bytes minimum).
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Comma-separated allowed frontend origins. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000

# Set to true only when a proxy you control (Render, nginx, a load balancer)
# sits in front of this process and sets X-Forwarded-For. Leaving it false
# behind a proxy makes every client share one rate-limit bucket; setting it
# true without a proxy lets any caller forge their own IP.
TRUST_PROXY=false

# Upper bound on a single request, database work included.
REQUEST_TIMEOUT=5s

# bcrypt work factor. Each step doubles the CPU spent per login (~50ms at 10,
# ~200ms at 12 on an M3). Lower it on a throttled shared vCPU if logins drag;
# values below 10 are refused.
BCRYPT_COST=12

APP_NAME=MasterFabric Raw LLM Monitoring & Decision Scoring
APP_VERSION=0.1.0

# ---- Server-side inference (optional) ----------------------------------
#
# Empty LLM_BASE_URL disables server-side inference entirely: POST /llm/generate
# and the whole /analysis surface answer 503, and the browser path keeps
# working. That is deliberate — the inference host is a desktop machine, and the
# API must not require it to be switched on.
#
# The root of an OpenAI-compatible API with NO trailing /v1. When the tunnel is
# up this is the Cloudflare hostname in front of the Caddy gateway; with the
# quick tunnel it changes on every restart, so it has to be updated each time.
LLM_BASE_URL=
# The shared secret the gateway checks as X-API-Key. Must match LLM_API_KEY in
# mf-inference/.env, or every request comes back 401 from the gateway.
LLM_API_KEY=
# One generation's bound. Must stay below the server's WriteTimeout and below
# the gateway's proxy timeouts in mf-inference/gateway/Caddyfile, or the gateway
# cuts the response before this service gives up and the caller sees a confusing
# 502 instead of a timeout.
LLM_TIMEOUT=25s
LLM_MAX_TOKENS=512

# ---- Control plane ------------------------------------------------------
#
# The one account promoted to the admin role at boot. There is no API route that
# grants this role: an endpoint that did would turn any authentication flaw into
# full control of the inference host's settings. Leave empty and every account
# stays unprivileged, which is the right default for a fresh database.
ADMIN_EMAIL=

# Guards GET /metrics. The Prometheus exposition maps every route, its traffic
# and its latency, so it is not something to publish. Empty leaves it open,
# which is right locally and refused in production.
METRICS_TOKEN=
