# Kaggle credentials for the PEFT workflow. Copy to .env (gitignored) and fill
# in real values; never put them here.
#
#   cp .env.example .env && chmod 600 .env
#
# Nothing loads this file automatically — unlike mf-inference/.env, which Docker
# Compose picks up on its own. Source it in the shell that needs it:
#
#   source mf-inference/peft/.env
#
# Sourcing it from ~/.zshrc instead would put the token in every shell on the
# machine, including ones running code that has no business reading it.

# --- Kaggle CLI 2.x ---------------------------------------------------------
# The CLI no longer takes a username/key pair. Generate a token at
# kaggle.com/settings/api ("Generate New Token") and paste the single opaque
# string below. Alternatively skip this file entirely and run `kaggle auth
# login`, which does a browser OAuth flow and caches its own credentials.
#
# Do not wrap the value in <angle brackets>: the shell reads < and > as
# redirections and `source` fails with a parse error before anything is set.
export KAGGLE_API_TOKEN=

# --- kagglehub / the classic Python client ----------------------------------
# The Python packages still authenticate with this pair, so a notebook pulled
# down from Kaggle and run locally wants these rather than the token above.
# Same page: kaggle.com/settings/api.
export KAGGLE_USERNAME=
export KAGGLE_KEY=
