data/
out/

# push.sh assembles the Kaggle upload here: the jsonl splits plus copies of the
# scripts. Everything in it is derived, and it carries the same data files that
# data/ is excluded for — the generator plus a fixed seed is the reproducible
# artefact, a copied file is not.
kaggle/.stage/

# Same reasoning for the pilot upload, and one more: it carries a 47 MB adapter.
# The adapter is a build output — it belongs in the Kaggle dataset it was
# uploaded to, not in git.
kaggle/.stage-pilot/

# push_persona.sh's staging area, same reasoning again.
kaggle/.stage-persona/
