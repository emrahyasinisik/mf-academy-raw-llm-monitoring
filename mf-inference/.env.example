# Copy to .env and fill in. Never commit the real .env.

# Shared secret the Go backend sends as X-API-Key. Generate a long random value:
#   PowerShell:  [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
# The same value goes into the backend's LLM_API_KEY.
LLM_API_KEY=

# Token from the Cloudflare Zero Trust dashboard when you create the tunnel
# (Networks -> Tunnels -> Create a tunnel -> Docker). It embeds the tunnel's
# credentials, so treat it like a password.
TUNNEL_TOKEN=

# The model to serve. Must be an MLC-compiled repo; the id matches the browser
# catalog in mf-backend/internal/llm/handler.go so the same model can be
# compared across targets.
MLC_MODEL=HF://mlc-ai/gemma-2-2b-it-q4f16_1-MLC

# CUDA wheel tag. Must match the base image in mlc/Dockerfile, and must be one
# of the tags MLC actively publishes — see the notes in that file before
# changing it, several of the obvious choices fail in non-obvious ways.
CUDA_TAG=cu128

# Optional: where mlc/llamacpp mount their models from. Only needed if the
# system drive is too small to hold model builds and models/ has been turned
# into a symlink to another drive — Docker's bind-mount layer cannot read
# through a symlink that crosses drives, so point this at the real path
# directly. Leave unset to use ./models.
# MODELS_DIR=E:/mf-inference-models
