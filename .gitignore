# Monorepo root ignores (per-package .gitignore files also apply)

# Env / secrets
**/.env
**/.env.local
**/.env.*.local

# Node / Next.js
**/node_modules/
**/.next/
**/out/

# Go build artifacts (anchored paths — must NOT match Next.js src/app or cmd/server)
mf-backend/app
mf-backend/mf-backend
mf-backend/server

# Built/downloaded model weights (GGUF, adapters) — too large for git
mf-inference/models/

# Misc
.DS_Store
*.log

# Prometheus scrape credential (see mf-observability/.env.example)
mf-observability/prometheus/metrics-token
